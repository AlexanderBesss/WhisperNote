<Window x:Class="WhisperNote.RecordingOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recording"
        Width="340" Height="58"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        IsHitTestVisible="False"
        WindowStartupLocation="Manual"
        Background="Transparent"
        AllowsTransparency="True"
        ShowActivated="False">

    <!-- Bottom-center pill shown while recording; matches the app's dark design.
         Click-through and non-activating so dictation focus never leaves the target app. -->
    <Border Background="#E61A1A1A" CornerRadius="18" Padding="18,10"
            BorderBrush="#3A3A3A" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.55"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="14" Height="14" Fill="#E5484D" VerticalAlignment="Center">
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0.2" Duration="0:0:0.7"
                                                 AutoReverse="True" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Recording…" FontSize="14" FontWeight="SemiBold"
                           Foreground="#F0F0F0"/>
                <TextBlock Text="{Binding InfoText}" FontSize="11" Foreground="#9A9A9A"
                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="270"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

<Window x:Class="WhisperNote.RecordingOverlayWindow"
        x:Name="OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WhisperNote"
        Title="Recording"
        Width="300" Height="98"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        IsHitTestVisible="False"
        WindowStartupLocation="Manual"
        Background="Transparent"
        AllowsTransparency="True"
        ShowActivated="False">

    <!-- The 20-unit margin gives the DropShadowEffect room; without it the shadow clips square at the window bounds. -->
    <Border Background="#E61A1A1A" CornerRadius="16" Padding="18,10" Margin="20"
            BorderBrush="#3A3A3A" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.55"/>
        </Border.Effect>
        <Grid>
            <!-- Background layer: the live mic signal drawn behind the status text.
                 The negative margin cancels the Border padding so the bars span the
                 whole pill; the Border clips the control to the rounded corners.
                 Visibility needs two sources (the recording state and the setting),
                 so it is a MultiBinding rather than a single Binding. -->
            <local:VoiceVisualizer x:Name="Visualizer"
                                   Margin="-18,-10"
                                   Opacity="0.6"
                                   IsHitTestVisible="False"
                                   ClipToBounds="True"
                                   Source="{Binding Spectrum}"
                                   Mode="{Binding VisualizerStyle, ElementName=OverlayWindow}"
                                   Palette="{Binding VisualizerPalette, ElementName=OverlayWindow}">
                <local:VoiceVisualizer.Visibility>
                    <MultiBinding Converter="{StaticResource AllTrueToVisibilityConverter}">
                        <Binding Path="IsRecording"/>
                        <Binding Path="VisualizerEnabled" ElementName="OverlayWindow"/>
                    </MultiBinding>
                </local:VoiceVisualizer.Visibility>
            </local:VoiceVisualizer>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="14" Height="14" Fill="#E5484D" VerticalAlignment="Center"
                         Visibility="{Binding IsRecording, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="1" To="0.2" Duration="0:0:0.7"
                                                     AutoReverse="True" RepeatBehavior="Forever"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <Grid Width="16" Height="16" Margin="8,0,0,0" VerticalAlignment="Center"
                      Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Path Stroke="#ADD8E6" StrokeThickness="2.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 8,1 A 7,7 0 1 1 1,8"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform/>
                        </Path.RenderTransform>
                        <Path.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:0.9"
                                                         RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Path.Triggers>
                    </Path>
                </Grid>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <!-- One status line: recording and processing can be true at the same
                         time, and both words shown as two lines would overflow the pill. -->
                    <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="SemiBold"
                               Foreground="#F0F0F0" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                    <TextBlock Text="{Binding InfoText}" FontSize="11" Foreground="#9A9A9A"
                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>

<Window x:Class="WhisperNote.RecordingOverlayWindow"
        x:Name="OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WhisperNote"
        Title="Recording"
        Width="300" Height="113"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        IsHitTestVisible="False"
        WindowStartupLocation="Manual"
        Background="Transparent"
        AllowsTransparency="True"
        ShowActivated="False">

    <Grid>
        <!-- The 20-unit margin gives the DropShadowEffect room; without it the shadow clips square at the window bounds. -->
        <Border Background="#E61A1A1A" CornerRadius="16" Padding="18,10" Margin="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.55"/>
            </Border.Effect>
            <Grid>
                <!-- Background layer: the live mic signal drawn behind the status text.
                     The negative margin cancels the Border padding so the bars span the
                     whole pill; the Border clips the control to the rounded corners.
                     Visibility needs two sources (the recording state and the setting),
                     so it is a MultiBinding rather than a single Binding. -->
                <local:VoiceVisualizer x:Name="Visualizer"
                                       Margin="-18,-10"
                                       Opacity="0.6"
                                       IsHitTestVisible="False"
                                       ClipToBounds="True"
                                       Source="{Binding Spectrum}"
                                       Mode="{Binding VisualizerStyle, ElementName=OverlayWindow}"
                                       Palette="{Binding VisualizerPalette, ElementName=OverlayWindow}"
                                       FrameFps="{Binding VisualizerFps, ElementName=OverlayWindow}">
                    <local:VoiceVisualizer.Visibility>
                        <MultiBinding Converter="{StaticResource AllTrueToVisibilityConverter}">
                            <Binding Path="IsRecording"/>
                            <Binding Path="VisualizerEnabled" ElementName="OverlayWindow"/>
                        </MultiBinding>
                    </local:VoiceVisualizer.Visibility>
                </local:VoiceVisualizer>

                <!-- Post-recording pass indicator: the same full-pill treatment as
                     the voice visualizer, shown while transcript/grammar work runs,
                     in the style picked in Settings. -->
                <local:ProcessingVisualizer x:Name="Processing"
                                            Margin="-18,-10"
                                            Opacity="0.55"
                                            IsHitTestVisible="False"
                                            ClipToBounds="True"
                                            Mode="{Binding ProcessingAnimation, ElementName=OverlayWindow}"
                                            Palette="{Binding VisualizerPalette, ElementName=OverlayWindow}"
                                            FrameFps="{Binding VisualizerFps, ElementName=OverlayWindow}"
                                            Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Queue bar in the pill's right corner: one square for the clip in
                     flight (pulsing) plus one per clip waiting behind it. The squares
                     are pinned to the right edge, so finishing a job plays a slide-off
                     ghost and joining the queue pops a new square in. The size is
                     MaxSquares * Pitch = 45 x 12 from QueueBar. -->
                <local:QueueBar x:Name="Queue" Width="45" Height="12"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,2,0,0"
                                Squares="{Binding QueueSquares}"
                                Palette="{Binding VisualizerPalette, ElementName=OverlayWindow}"
                                FrameFps="{Binding VisualizerFps, ElementName=OverlayWindow}"/>

                <StackPanel x:Name="StatusTextPanel" VerticalAlignment="Center">
                    <!-- The status text yields to whichever animation owns the
                         pill: processing hides it for the processing animation,
                         and recording hides it for the voice visualizer when
                         that is enabled. With the visualizer off, the text is
                         the only recording feedback, so it stays. -->
                    <StackPanel.Visibility>
                        <MultiBinding Converter="{StaticResource ProcessingOrAllTrueToHiddenConverter}">
                            <Binding Path="IsProcessing"/>
                            <Binding Path="IsRecording"/>
                            <Binding Path="VisualizerEnabled" ElementName="OverlayWindow"/>
                        </MultiBinding>
                    </StackPanel.Visibility>
                    <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="SemiBold"
                               Foreground="#F0F0F0" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                    <TextBlock Text="{Binding InfoText}" FontSize="11" Foreground="#9A9A9A"
                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Glowing animated outline while the overlay is shown (recording or
             processing): the colours flow along the pill edge. Same 20-unit margin
             and radius as the Border, and the glow spills into the transparent
             margin around it. -->
        <local:GlowBorder x:Name="Glow" Margin="20"
                          Palette="{Binding VisualizerPalette, ElementName=OverlayWindow}"
                          FrameFps="{Binding VisualizerFps, ElementName=OverlayWindow}"/>
    </Grid>
</Window>

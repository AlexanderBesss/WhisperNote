<Window x:Class="WhisperNote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WhisperNote"
        Width="370" Height="280"
        Topmost="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- Same visual language as the recording pill: translucent dark fill,
         thin outline, soft drop shadow. The margin gives the shadow room to
         fade inside the window's rectangular bounds, so no dark square corners. -->
    <Border Background="#E61A1A1A" CornerRadius="16" Padding="12,8,12,12" Margin="20"
            BorderBrush="#3A3A3A" BorderThickness="1"
            Opacity="{Binding WindowOpacity}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.55"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" ClipToBounds="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="WhisperNote" FontSize="16" FontWeight="SemiBold"
                                   Foreground="#F0F0F0" VerticalAlignment="Center"/>
                        <TextBlock Width="8" Height="8" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Text="&#x2022;" FontSize="10"
                                   Foreground="{Binding ServerManager.Status.Kind, Converter={StaticResource ServerStatusKindToBrushConverter}}"/>
                        <TextBlock Text="{Binding ServerManager.Status.Message}" FontSize="11"
                                   Foreground="{Binding ServerManager.Status.Kind, Converter={StaticResource ServerStatusKindToBrushConverter}}"
                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                   MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{Binding HardwareMode}" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{Binding HardwareModeForeground}"
                                   Visibility="{Binding HardwareMode, Converter={StaticResource StringToVisibilityConverter}}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding ServerCommand}"
                            Width="28" Height="28" Padding="0"
                            VerticalAlignment="Center" Margin="6,0,0,0"
                            ToolTip="Power LLM">
                        <TextBlock Text="&#x23FB;" FontSize="13"
                                   Foreground="{Binding ServerManager.Status.Kind, Converter={StaticResource ServerStatusKindToBrushConverter}}"/>
                    </Button>
                    <Button Command="{Binding DownloadModelCommand}"
                            Style="{StaticResource IconButton}"
                            Width="28" Height="28" Padding="0"
                            VerticalAlignment="Center" Margin="6,0,6,0"
                            Visibility="{Binding ModelMissing, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="Download model">
                        <TextBlock Text="&#x2B07;" FontSize="13" Foreground="#FFA500"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            Width="28" Height="28" Padding="0"
                            VerticalAlignment="Center" Margin="6,0,0,0"
                            Click="SettingsButton_Click"
                            AutomationProperties.Name="Settings"
                            ToolTip="Settings">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#B8B8B8"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            Width="28" Height="28" Padding="0"
                            VerticalAlignment="Center" Margin="6,0,0,0"
                            Click="CloseButton_Click"
                            AutomationProperties.Name="Close"
                            ToolTip="Close (keeps WhisperNote running in the tray)">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#B8B8B8"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main recording area -->
            <Grid Grid.Row="1">
                <Border Background="#CC222222" CornerRadius="12" Padding="16" ClipToBounds="True"
                        BorderBrush="#3A3A3A" BorderThickness="1">
                    <Grid>
                        <!-- Status text -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Focusable="True" FocusManager.IsFocusScope="True">
                                <TextBlock Text="{Binding RecordingManager.StatusText}"
                                           FontSize="14" FontWeight="Medium"
                                           Foreground="{Binding RecordingManager.StatusTextKind, Converter={StaticResource StatusKindToBrushConverter}}"
                                           TextWrapping="Wrap"/>
                            </ScrollViewer>

                            <TextBlock Grid.Row="1" Text="{Binding RecordingManager.InfoText}"
                                       FontSize="11" Foreground="#9A9A9A"
                                       Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="2" Text="{Binding HotkeyName}"
                                       FontSize="9" Foreground="#6A6A6A"
                                       Margin="0,2,0,0" Opacity="0.7"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>

<Window x:Class="WhisperNote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WhisperNote"
        Width="380" Height="260"
        Topmost="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#1A1A1A" CornerRadius="12" Padding="20" ClipToBounds="True"
            Opacity="{Binding WindowOpacity}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" ClipToBounds="True">
                    <TextBlock Text="WhisperNote" FontSize="16" FontWeight="SemiBold"
                               Foreground="#E0E0E0" VerticalAlignment="Center"/>
                    <TextBlock Width="8" Height="8" Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Text="&#x2022;" FontSize="10"
                               Foreground="{Binding ServerManager.Status.Kind, Converter={StaticResource ServerStatusKindToBrushConverter}}"/>
                    <TextBlock Text="{Binding ServerManager.Status.Message}" FontSize="11"
                               Foreground="{Binding ServerManager.Status.Kind, Converter={StaticResource ServerStatusKindToBrushConverter}}"
                               VerticalAlignment="Center" Margin="6,0,0,0"
                               MaxWidth="92" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding ProviderMode}"
                               FontSize="9" FontWeight="SemiBold"
                               Foreground="#888"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBlock Text="{Binding HardwareMode}"
                               FontSize="9" FontWeight="SemiBold"
                               Foreground="{Binding HardwareModeForeground}"
                               VerticalAlignment="Center" Margin="6,0,0,0"
                               Visibility="{Binding HardwareMode, Converter={StaticResource StringToVisibilityConverter}}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding DownloadModelCommand}"
                            Style="{StaticResource IconButton}"
                            Width="28" Height="28" Padding="0"
                            VerticalAlignment="Center" Margin="6,0,6,0"
                            Visibility="{Binding ModelMissing, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="Download model">
                        <TextBlock Text="&#x2B07;" FontSize="13" Foreground="#FFA500"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            Width="28" Height="28" Padding="0"
                            VerticalAlignment="Center"
                            Click="SettingsButton_Click"
                            AutomationProperties.Name="Settings"
                            ToolTip="Settings">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#B8B8B8"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main recording area -->
            <Grid Grid.Row="1">
                <Border Background="#222" CornerRadius="16" Padding="20,12,20,12" ClipToBounds="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Record button (click fallback) -->
                        <Button Grid.Column="0"
                                Style="{StaticResource CircleButton}"
                                Width="64" Height="64"
                                Background="{Binding RecordingManager.MainButtonBackgroundKind, Converter={StaticResource ButtonBackgroundKindToBrushConverter}}"
                                BorderBrush="#555" BorderThickness="2"
                                Command="{Binding RecordCommand}"
                                Cursor="Hand">
                            <Ellipse Width="18" Height="18" Fill="#E0E0E0"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Status text -->
                        <Grid Grid.Column="1" Margin="16,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollViewer x:Name="StatusScrollViewer" Grid.Row="0"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Focusable="True" FocusManager.IsFocusScope="True"
                                          Padding="4,0,4,0">
                                <TextBlock Text="{Binding RecordingManager.StatusText}"
                                           FontSize="14" FontWeight="Medium"
                                           Foreground="{Binding RecordingManager.StatusTextKind, Converter={StaticResource StatusKindToBrushConverter}}"
                                           TextWrapping="Wrap"/>
                            </ScrollViewer>

                            <TextBlock Grid.Row="1" Text="{Binding RecordingManager.InfoText}"
                                       FontSize="11" Foreground="#666"
                                       Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="2" Text="{Binding HotkeyName}"
                                       FontSize="9" Foreground="#555"
                                       Margin="0,2,0,0" Opacity="0.7"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Primary controls: server power remains on the main window. -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0"
                        HorizontalAlignment="Center">
                <Button Style="{StaticResource IconButton}"
                        Command="{Binding ServerCommand}"
                        Margin="0,0,8,0"
                        ToolTip="Power LLM">
                    <TextBlock Text="&#x23FB;" FontSize="17"
                               Foreground="{Binding ServerManager.Status.Kind, Converter={StaticResource ServerStatusKindToBrushConverter}}"/>
                </Button>
                <Button Style="{StaticResource IconButton}"
                        Command="{Binding CloseCommand}"
                        ToolTip="Close">
                    <TextBlock Text="&#x2715;" FontSize="14"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>

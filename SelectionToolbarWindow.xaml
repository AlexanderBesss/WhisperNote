<Window x:Class="WhisperNote.SelectionToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SelectionToolbar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
    <Border Background="#1F1F1F" BorderBrush="#444" BorderThickness="1"
            CornerRadius="8" Padding="5"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
        </Border.Effect>
        <Grid>
            <Button x:Name="FixButton"
                    Content="Fix"
                    Click="FixButton_Click"
                    Style="{StaticResource ModernButton}"
                    Padding="12,5"
                    FontSize="12"/>
            <!-- Spinner shown in place of the button while the API round trip runs. -->
            <TextBlock x:Name="ProcessingGlyph"
                       Text="&#xE72C;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="16"
                       Foreground="#CFCFCF"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="9,4"
                       Visibility="Collapsed"/>
            <!-- Success flash shown in place of the button after a fix lands. -->
            <TextBlock x:Name="DoneGlyph"
                       Text="&#xE73E;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="18"
                       Foreground="#3FAE65"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="9,3"
                       Visibility="Collapsed"/>
            <!-- Failure flash (API timeout, nothing selected, paste refused...). -->
            <TextBlock x:Name="FailedGlyph"
                       Text="&#xE711;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="18"
                       Foreground="#D9534F"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="9,3"
                       Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>

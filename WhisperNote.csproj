<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- NotifyIcon for the tray comes from WinForms; both share the Windows Desktop runtime. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <AssemblyName>WhisperNote</AssemblyName>
    <RootNamespace>WhisperNote</RootNamespace>
    <ApplicationIcon>TrayIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WhisperNote.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded in the assembly so PublishSingleFile keeps the tray icons with the app. -->
    <EmbeddedResource Include="TrayIcon.ico">
      <LogicalName>WhisperNote.TrayIcon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="TrayIconIdle.ico">
      <LogicalName>WhisperNote.TrayIconIdle.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <None Include="tests\**\*.cs" />
  </ItemGroup>

 <!--
    Runtime payload (models + llama.cpp backends) is deliberately NOT published
    by the SDK. build.ps1 syncs it into publish/ with its own rules, so a rebuild
    can never delete the multi-gigabyte model files. CopyToPublishDirectory=Never
    keeps the SDK's incremental publish-clean away from these folders.
  -->
 <ItemGroup Condition="Exists('..\models\unslothai\Qwen3-ASR-1.7B-GGUF\Qwen3-ASR-1.7B-Q8_0.gguf')">
    <None Include="..\models\unslothai\Qwen3-ASR-1.7B-GGUF\Qwen3-ASR-1.7B-Q8_0.gguf" Link="models\Qwen3-ASR-1.7B-Q8_0.gguf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" ExcludeFromSingleFile="true" />
    <None Include="..\models\unslothai\Qwen3-ASR-1.7B-GGUF\mmproj-Qwen3-ASR-1.7B-Q8_0.gguf" Link="models\mmproj-Qwen3-ASR-1.7B-Q8_0.gguf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" ExcludeFromSingleFile="true" />
  </ItemGroup>


  <ItemGroup>
    <None Include="..\llm-servers\llama\windows\llama\**" Link="llama\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\llm-servers\llama\windows\vulkan\**" Exclude="..\llm-servers\llama\windows\vulkan\*.ps1;..\llm-servers\llama\windows\vulkan\*.log" Link="vulkan\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- CUDA 12.4 backend: the only CUDA build that still runs Maxwell/Pascal/Volta. -->
  <ItemGroup>
    <None Include="..\llm-servers\llama\windows\cuda12\**" Exclude="..\llm-servers\llama\windows\cuda12\*.ps1;..\llm-servers\llama\windows\cuda12\*.log" Link="cuda12\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\llm-servers\llama\windows\NPU\llama-ov\**" Link="NPU\llama-ov\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" ExcludeFromSingleFile="true" />
  </ItemGroup>



</Project>

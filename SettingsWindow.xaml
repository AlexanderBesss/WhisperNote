<Window x:Class="WhisperNote.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WhisperNote"
        Title="WhisperNote Settings"
        Width="344" Height="373"
        MinWidth="320" MaxWidth="420"
        MinHeight="240" MaxHeight="640"
        Topmost="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewMouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="SwitchToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="21"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" CornerRadius="10.5"
                                Background="#3C3C3C" BorderBrush="#4C4C4C" BorderThickness="1">
                            <Ellipse x:Name="Thumb" Width="13" Height="13" Fill="#C8C8C8"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentDeepBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Track" Property="Background" Value="#4A4A4A"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillTab" TargetType="RadioButton">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#9A9A9A"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pill" CornerRadius="7" Background="Transparent"
                                Padding="0,5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource AccentDeepBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Pill" Property="Background" Value="#2E2E2E"/>
                                <Setter Property="Foreground" Value="#D0D0D0"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="#CC222222"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SettingRowName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <local:PaletteGradientConverter x:Key="PaletteGradient"/>
        <DataTemplate x:Key="PaletteChipTemplate">
            <StackPanel Orientation="Horizontal">
                <Border Width="26" Height="12" CornerRadius="3" Margin="0,0,7,0"
                        Background="{Binding Converter={StaticResource PaletteGradient}}"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <!-- No drop shadow: on this layered window it composites as a dark square; 1px bottom margin keeps the outline off the clipped last pixel row. -->
    <Grid>
    <Border Background="#E61A1A1A" CornerRadius="16" Padding="12,8,12,12" Margin="0,0,0,1"
            BorderBrush="#3A3A3A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center"/>
                    <TextBlock Text="WhisperNote Settings" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}"
                            Width="28" Height="28" Padding="0"
                            Click="CloseButton_Click"
                            ToolTip="Close settings">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="12" Foreground="#B8B8B8"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="#1E1E1E" BorderBrush="#353535"
                    BorderThickness="1" CornerRadius="9" Padding="3" Margin="0,0,0,10">
                <UniformGrid Columns="3">
                    <RadioButton x:Name="TabOutput" Style="{StaticResource PillTab}"
                                 Content="General" GroupName="SettingsTabs" Tag="output"
                                 IsChecked="True" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabVisualizer" Style="{StaticResource PillTab}" FontSize="10"
                                 Content="Visualization" GroupName="SettingsTabs" Tag="visualizer"
                                 Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabModel" Style="{StaticResource PillTab}"
                                 Content="Model" GroupName="SettingsTabs" Tag="model"
                                 Checked="Tab_Checked"/>
                </UniformGrid>
            </Border>

            <!-- The grid must keep its full desired height: clamping it to the viewport
                 would hide the overflow instead of scrolling it. Top alignment is deliberate
                 too: a centred grid pushes a short tab down and leaves dead space. -->
            <ScrollViewer x:Name="PanelScroll" Grid.Row="2"
                          Style="{StaticResource StyledScrollViewer}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <Grid VerticalAlignment="Top">
                <Border x:Name="PanelModel" Style="{StaticResource SettingsCard}"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Local transcription model" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding LocalModelOptions}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding LocalModelId, Mode=TwoWay}"
                                  Height="28"
                                  Margin="0,0,0,10"/>

                        <TextBlock Text="Grammar" Style="{StaticResource FieldLabel}"/>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Grammar check" Style="{StaticResource SettingRowName}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{Binding GrammarStateBrush}"
                                         Margin="0,0,8,0"
                                         ToolTip="{Binding GrammarStatus}"/>
                                <ToggleButton Style="{StaticResource SwitchToggle}"
                                              IsChecked="{Binding GrammarEnabled, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              ToolTip="Re-read the transcript with a custom LLM and copy the corrected text instead"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="66"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="API host" Style="{StaticResource SettingRowName}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource SettingsField}"
                                     Tag="https://api.openai.com/v1"
                                     IsEnabled="{Binding GrammarEnabled}"
                                     Text="{Binding GrammarApiHost, Mode=TwoWay}"
                                     ToolTip="Root of an OpenAI-compatible API: /v1/models and /v1/chat/completions are appended to it"/>
                        </Grid>

                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="66"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="API key" Style="{StaticResource SettingRowName}"/>
                            <PasswordBox x:Name="ApiKeyBox" Grid.Column="1" Style="{StaticResource SettingsPasswordField}"
                                         Tag="not required for a local server"
                                         IsEnabled="{Binding GrammarEnabled}"
                                         ToolTip="Masked on screen; sent as a Bearer token and saved in whispernote.json"/>
                        </Grid>

                        <Grid Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="66"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Effort" Style="{StaticResource SettingRowName}"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource SettingsCombo}"
                                      ItemsSource="{Binding GrammarEffortOptions}"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding GrammarEffort, Mode=TwoWay}"
                                      IsEnabled="{Binding GrammarEnabled}"
                                      ToolTip="Sent to the API as reasoning_effort. Off answers fastest (the model is told not to think out loud); Server default sends nothing and leaves it to the endpoint."/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="PanelOutput" Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="Recording hotkey" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding HotkeyOptions}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="VirtualKeyCode"
                                  SelectedValue="{Binding HotkeyVirtualKeyCode, Mode=TwoWay}"
                                  Height="28"
                                  Margin="0,0,0,6"
                                  ToolTip="Hold this key to dictate; release to stop and transcribe."/>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Selection toolbar" Style="{StaticResource SettingRowName}"/>
                            <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                          IsChecked="{Binding SelectionToolbarEnabled, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          ToolTip="Show a small &quot;Fix&quot; button next to selected text; click it to proofread and replace the selection. Works in apps that expose text selection (browsers, Office, WordPad)."/>
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Auto-offload VRAM" Style="{StaticResource SettingRowName}"/>
                            <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                          IsChecked="{Binding AutoOffloadVram, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          ToolTip="Stop the local server after each transcription"/>
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Run on CPU" Style="{StaticResource SettingRowName}"/>
                            <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                          IsChecked="{Binding UseCpuOnly, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          ToolTip="Load the local model into RAM and process audio with the CPU instead of GPU/NPU"/>
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Autopaste" Style="{StaticResource SettingRowName}"/>
                            <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                          IsChecked="{Binding AutoPaste, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          ToolTip="Paste the transcription into the focused input field after copying"/>
                        </Grid>

                        <TextBlock Text="Startup and tray" Style="{StaticResource FieldLabel}"
                                   Margin="0,8,0,4"/>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Start in tray" Style="{StaticResource SettingRowName}"/>
                            <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                          IsChecked="{Binding StartInTray, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          ToolTip="Launch WhisperNote hidden in the notification area; click the tray icon to open it"/>
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Minimize to tray" Style="{StaticResource SettingRowName}"/>
                            <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                          IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          ToolTip="Hide WhisperNote in the notification area instead of exiting"/>
                        </Grid>

                        <Grid Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Run on Windows startup" Style="{StaticResource SettingRowName}"/>
                            <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                          IsChecked="{Binding StartupEnabled, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          ToolTip="Start WhisperNote when you sign in"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="PanelVisualizer" Style="{StaticResource SettingsCard}"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Microphone" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Style="{StaticResource SettingsCombo}"
                                  ItemsSource="{Binding MicOptions}"
                                  SelectedValuePath="Number"
                                  SelectedValue="{Binding MicDeviceNumber, Mode=TwoWay}"
                                  Margin="0,0,0,8"
                                  ToolTip="Device held-to-talk dictation records from"/>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Voice visualizer" Style="{StaticResource SettingRowName}"/>
                            <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                          IsChecked="{Binding VisualizerEnabled, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          ToolTip="Draw the live microphone levels in the background of the recording overlay while dictating"/>
                        </Grid>

                        <TextBlock Text="Colours" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Style="{StaticResource SettingsCombo}"
                                  ItemsSource="{Binding VisualizerPaletteOptions}"
                                  ItemTemplate="{StaticResource PaletteChipTemplate}"
                                  SelectedValuePath="Name"
                                  SelectedValue="{Binding VisualizerPalette, Mode=TwoWay}"
                                  IsEnabled="{Binding VisualizerEnabled}"
                                  ToolTip="Colour scheme of the recording and processing animations"/>

                        <TextBlock Text="Animation speed" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Style="{StaticResource SettingsCombo}"
                                  ItemsSource="{Binding VisualizerFpsOptions}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Fps"
                                  SelectedValue="{Binding VisualizerFps, Mode=TwoWay}"
                                  IsEnabled="{Binding VisualizerEnabled}"
                                  Margin="0,0,0,8"
                                  ToolTip="Frames per second the overlay redraws at. All options animate at the same speed; higher values only render smoother. Rates above your monitor's refresh are not offered"/>

                        <TextBlock Text="Style" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Style="{StaticResource SettingsCombo}"
                                  ItemsSource="{Binding VisualizerStyleOptions}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Name"
                                  SelectedValue="{Binding VisualizerStyle, Mode=TwoWay}"
                                  IsEnabled="{Binding VisualizerEnabled}"
                                  ToolTip="Which shape is drawn behind the recording status text"/>

                        <Border Background="#151515" BorderBrush="#333" BorderThickness="1"
                                CornerRadius="6" Height="73" ClipToBounds="True" Margin="0,0,0,8"
                                Visibility="{Binding VisualizerEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <local:VoiceVisualizer Mode="{Binding PreviewStyle}"
                                                   Palette="{Binding PreviewPalette}"
                                                   FrameFps="{Binding VisualizerFps}"
                                                   Source="{Binding PreviewSource.Spectrum}"
                                                   Margin="8,5"/>
                        </Border>

                        <TextBlock Text="Processing animation" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Style="{StaticResource SettingsCombo}"
                                  ItemsSource="{Binding ProcessingOptions}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Name"
                                  SelectedValue="{Binding ProcessingAnimation, Mode=TwoWay}"
                                  ToolTip="Animation the overlay loops while the recording is transcribed and polished after you release the button"/>

                        <!-- The processing indicator runs independently of the
                             recording visualizer, so its preview stays available. -->
                        <Border Background="#151515" BorderBrush="#333" BorderThickness="1"
                                CornerRadius="6" Height="73" ClipToBounds="True">
                            <local:ProcessingVisualizer Mode="{Binding PreviewProcessingStyle}"
                                                        Palette="{Binding PreviewPalette}"
                                                        FrameFps="{Binding VisualizerFps}"
                                                        Margin="8,5"/>
                        </Border>
                    </StackPanel>
                </Border>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>

    <local:GlowBorder Palette="{Binding PreviewPalette}"
                      FrameFps="{Binding VisualizerFps}"
                      Margin="0,0,0,1"/>
    </Grid>
</Window>

<Window x:Class="WhisperNote.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WhisperNote Settings"
        Width="320" Height="230"
        MinWidth="300" MaxWidth="380"
        MinHeight="220" MaxHeight="640"
        Topmost="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewMouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- iOS-style sliding switch: pill track with a thumb that slides right. -->
        <Style x:Key="SwitchToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="21"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" CornerRadius="10.5"
                                Background="#3C3C3C" BorderBrush="#4C4C4C" BorderThickness="1">
                            <Ellipse x:Name="Thumb" Width="13" Height="13" Fill="#C8C8C8"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#2D8A4E"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#3FAE65"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Track" Property="Background" Value="#4A4A4A"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill tab in the segmented tab bar. -->
        <Style x:Key="PillTab" TargetType="RadioButton">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#9A9A9A"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pill" CornerRadius="7" Background="Transparent"
                                Padding="0,5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#2D8A4E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Pill" Property="Background" Value="#2E2E2E"/>
                                <Setter Property="Foreground" Value="#D0D0D0"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Content card shared by all tabs. -->
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="#CC222222"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <!-- One-line setting row: name on the left, control on the right. -->
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SettingRowName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#A8A8A8"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Foreground" Value="#8A8A8A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <!-- Same visual language as the recording pill: translucent dark fill and
         thin outline. No drop shadow here: on the layered transparent window it
         composited as a dark square behind the rounded corners. The 1px bottom
         margin keeps the outline off the window's clipped last pixel row. -->
    <Border Background="#E61A1A1A" CornerRadius="16" Padding="12,8,12,12" Margin="0,0,0,1"
            BorderBrush="#3A3A3A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="8" Height="8" CornerRadius="4" Background="#3FAE65"
                            VerticalAlignment="Center"/>
                    <TextBlock Text="WhisperNote Settings" FontSize="14" FontWeight="SemiBold"
                               Foreground="#F0F0F0" Margin="7,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}"
                            Width="28" Height="28" Padding="0"
                            Click="SaveButton_Click" ToolTip="Save settings">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="13" Foreground="#3FAE65"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            Width="28" Height="28" Padding="0" Margin="6,0,0,0"
                            Click="CancelButton_Click"
                            ToolTip="Close settings">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="12" Foreground="#B8B8B8"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Segmented tab bar -->
            <Border Grid.Row="1" Background="#1E1E1E" BorderBrush="#353535"
                    BorderThickness="1" CornerRadius="9" Padding="3" Margin="0,0,0,10">
                <UniformGrid Columns="4">
                    <RadioButton x:Name="TabModel" Style="{StaticResource PillTab}"
                                 Content="Model" GroupName="SettingsTabs" Tag="model"
                                 IsChecked="True" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabRecord" Style="{StaticResource PillTab}"
                                 Content="Hotkey" GroupName="SettingsTabs" Tag="record"
                                 Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabOutput" Style="{StaticResource PillTab}"
                                 Content="Engine" GroupName="SettingsTabs" Tag="output"
                                 Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabSystem" Style="{StaticResource PillTab}"
                                 Content="System" GroupName="SettingsTabs" Tag="system"
                                 Checked="Tab_Checked"/>
                </UniformGrid>
            </Border>

            <!-- Tab content -->
            <Grid Grid.Row="2" VerticalAlignment="Center">
                <!-- Model -->
                <Border x:Name="PanelModel" Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="Local transcription model" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding LocalModelOptions}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding LocalModelId, Mode=TwoWay}"
                                  Height="28"/>
                        <TextBlock Text="Downloaded automatically on first use."
                                   Style="{StaticResource HintText}" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Record -->
                <Border x:Name="PanelRecord" Style="{StaticResource SettingsCard}"
                        Visibility="Collapsed">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Global hotkey" Style="{StaticResource SettingRowName}"/>
                            <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                          IsChecked="{Binding HotkeyEnabled, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          ToolTip="Hold the key to start and stop recording"/>
                        </Grid>

                        <TextBlock Text="Recording key" Style="{StaticResource FieldLabel}"
                                   Margin="0,4,0,4"/>
                        <ComboBox ItemsSource="{Binding HotkeyOptions}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="VirtualKeyCode"
                                  SelectedValue="{Binding HotkeyVirtualKeyCode, Mode=TwoWay}"
                                  IsEnabled="{Binding HotkeyEnabled}"
                                  Height="28"/>
                    </StackPanel>
                </Border>

                <!-- Output -->
                <Border x:Name="PanelOutput" Style="{StaticResource SettingsCard}"
                        Visibility="Collapsed">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Auto-offload VRAM" Style="{StaticResource SettingRowName}"/>
                            <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                          IsChecked="{Binding AutoOffloadVram, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          ToolTip="Stop the local server after each transcription"/>
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Run on CPU" Style="{StaticResource SettingRowName}"/>
                            <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                          IsChecked="{Binding UseCpuOnly, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          ToolTip="Load the local model into RAM and process audio with the CPU instead of GPU/NPU"/>
                        </Grid>

                        <Grid Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Autopaste" Style="{StaticResource SettingRowName}"/>
                            <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                          IsChecked="{Binding AutoPaste, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          ToolTip="Paste the transcription into the focused input field after copying"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- System -->
                <Border x:Name="PanelSystem" Style="{StaticResource SettingsCard}"
                        Visibility="Collapsed">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Start in tray" Style="{StaticResource SettingRowName}"/>
                            <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                          IsChecked="{Binding StartInTray, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          ToolTip="Launch WhisperNote hidden in the notification area; click the tray icon to open it"/>
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Minimize to tray" Style="{StaticResource SettingRowName}"/>
                            <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                          IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          ToolTip="Hide WhisperNote in the notification area instead of exiting"/>
                        </Grid>

                        <Grid Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Run on Windows startup" Style="{StaticResource SettingRowName}"/>
                            <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}"
                                          IsChecked="{Binding StartupEnabled, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          ToolTip="Start WhisperNote when you sign in"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>

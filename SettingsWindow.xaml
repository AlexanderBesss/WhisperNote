<Window x:Class="WhisperNote.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WhisperNote Settings"
        Width="440" Height="520"
        MinWidth="420" MaxWidth="460"
        MinHeight="440" MaxHeight="580"
        Topmost="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="SettingsToggleButton" TargetType="ToggleButton"
               BasedOn="{StaticResource IconToggleButton}">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Content" Value="OFF"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="ON"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsActionButton" TargetType="Button"
               BasedOn="{StaticResource ModernButton}">
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="CaretBrush" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Border Background="#1A1A1A" CornerRadius="12" Padding="20" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14"
                  MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold"
                           Foreground="#E8E8E8" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Style="{StaticResource IconButton}"
                        Width="28" Height="28" Padding="0"
                        HorizontalAlignment="Right"
                        Click="CancelButton_Click"
                        ToolTip="Close settings">
                    <TextBlock Text="&#x2715;" FontSize="14"/>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" Style="{StaticResource StyledScrollViewer}"
                           VerticalScrollBarVisibility="Auto"
                           HorizontalScrollBarVisibility="Disabled"
                           Focusable="False"
                           Padding="0,0,4,0">
                <StackPanel>
                    <TextBlock Text="LLM provider" FontSize="11" FontWeight="SemiBold"
                               Foreground="#8F8F8F" Margin="2,0,0,7"/>
                    <Border Background="#222" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Use cloud LLM" FontSize="13" Foreground="#E0E0E0"/>
                                    <TextBlock Text="Switch between the local model and the cloud endpoint."
                                               FontSize="10" Foreground="#777" Margin="0,3,0,0"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SettingsToggleButton}"
                                              IsChecked="{Binding UseRemote, Mode=TwoWay}"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Text="Cloud LLM URL" FontSize="12" Foreground="#CFCFCF"/>
                            <TextBox Text="{Binding CloudLlmUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,6,0,0"
                                     ToolTip="The HTTP or HTTPS base URL used by the cloud LLM"/>
                            <TextBlock Text="{Binding CloudLlmUrlValidationMessage}"
                                       Visibility="{Binding CloudLlmUrlValidationMessage, Converter={StaticResource StringToVisibilityConverter}}"
                                       FontSize="10" Foreground="#FCA5A5" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Behavior" FontSize="11" FontWeight="SemiBold"
                               Foreground="#8F8F8F" Margin="2,0,0,7"/>
                    <Border Background="#222" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Auto-offload VRAM" FontSize="13" Foreground="#E0E0E0"/>
                                    <TextBlock Text="Stop the local server after each transcription."
                                               FontSize="10" Foreground="#777" Margin="0,3,0,0"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SettingsToggleButton}"
                                              IsChecked="{Binding AutoOffloadVram, Mode=TwoWay}"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Thinking mode" FontSize="13" Foreground="#E0E0E0"/>
                                    <TextBlock Text="Use reasoning mode when the local server restarts."
                                               FontSize="10" Foreground="#777" Margin="0,3,0,0"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SettingsToggleButton}"
                                              IsChecked="{Binding ThinkingEnabled, Mode=TwoWay}"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Run on Windows startup" FontSize="13" Foreground="#E0E0E0"/>
                                    <TextBlock Text="Start WhisperNote when you sign in."
                                               FontSize="10" Foreground="#777" Margin="0,3,0,0"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SettingsToggleButton}"
                                              IsChecked="{Binding StartupEnabled, Mode=TwoWay}"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Recording" FontSize="11" FontWeight="SemiBold"
                               Foreground="#8F8F8F" Margin="2,0,0,7"/>
                    <Border Background="#222" CornerRadius="10" Padding="14" Margin="0,0,0,4">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Global hotkey" FontSize="13" Foreground="#E0E0E0"/>
                                    <TextBlock Text="Hold the key to start and stop recording."
                                               FontSize="10" Foreground="#777" Margin="0,3,0,0"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SettingsToggleButton}"
                                              IsChecked="{Binding HotkeyEnabled, Mode=TwoWay}"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Text="Recording key" FontSize="12" Foreground="#CFCFCF"/>
                            <ComboBox ItemsSource="{Binding HotkeyOptions}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="VirtualKeyCode"
                                      SelectedValue="{Binding HotkeyVirtualKeyCode, Mode=TwoWay}"
                                      IsEnabled="{Binding HotkeyEnabled}"
                                      Margin="0,6,0,0"
                                      Height="30"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button Style="{StaticResource SettingsActionButton}"
                        Background="#2A2A2A" BorderBrush="#444" BorderThickness="1"
                        Foreground="#CFCFCF"
                        Click="CancelButton_Click">Cancel</Button>
                <Button Style="{StaticResource SettingsActionButton}"
                        Background="#2D8A4E" BorderBrush="#3FAE65" BorderThickness="1"
                        Foreground="White" Margin="8,0,0,0"
                        IsEnabled="{Binding IsCloudLlmUrlValid}"
                        Click="SaveButton_Click">Save settings</Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>

<Window x:Class="WhisperNote.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WhisperNote Settings"
        Width="440" Height="680"
        MinWidth="420" MaxWidth="460"
        MinHeight="440" MaxHeight="740"
        Topmost="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="SettingsToggleButton" TargetType="ToggleButton"
               BasedOn="{StaticResource IconToggleButton}">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Content" Value="OFF"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="ON"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsActionButton" TargetType="Button"
               BasedOn="{StaticResource ModernButton}">
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="CaretBrush" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Border Background="#1A1A1A" CornerRadius="12" Padding="20" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14"
                  MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold"
                           Foreground="#E8E8E8" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Style="{StaticResource IconButton}"
                        Width="28" Height="28" Padding="0"
                        HorizontalAlignment="Right"
                        Click="CancelButton_Click"
                        ToolTip="Close settings">
                    <TextBlock Text="&#x2715;" FontSize="14"/>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" Style="{StaticResource StyledScrollViewer}"
                           VerticalScrollBarVisibility="Auto"
                           HorizontalScrollBarVisibility="Disabled"
                           Focusable="False"
                           Padding="0,0,4,0">
                <StackPanel>
                    <TextBlock Text="LLM provider" FontSize="11" FontWeight="SemiBold"
                               Foreground="#8F8F8F" Margin="2,0,0,7"/>
                    <Border Background="#222" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Use remote provider" FontSize="13" Foreground="#E0E0E0"/>
                                    <TextBlock Text="Switch between the local model and a configured remote mode."
                                               FontSize="10" Foreground="#777" Margin="0,3,0,0"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SettingsToggleButton}"
                                              IsChecked="{Binding UseRemote, Mode=TwoWay}"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Text="Remote provider mode" FontSize="12" Foreground="#CFCFCF"/>
                            <ComboBox ItemsSource="{Binding RemoteProviderModes}"
                                      SelectedItem="{Binding RemoteProviderMode, Mode=TwoWay}"
                                      Margin="0,6,0,12" Height="30"
                                      ToolTip="Direct API calls configured providers; RemoteExecution calls another WhisperNote instance"/>

                            <StackPanel Margin="0,0,0,12">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRemoteExecutionMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="WhisperNote server endpoint" FontSize="12" Foreground="#CFCFCF"/>
                                <TextBox Text="{Binding RemoteServerEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,6,0,0" ToolTip="Base HTTP URL of the server-role WhisperNote instance"/>
                            </StackPanel>

                            <TextBlock Text="Direct API endpoints" FontSize="12" Foreground="#CFCFCF"/>
                            <ItemsControl ItemsSource="{Binding CloudEndpoints}" Margin="0,3,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,5,0,0">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="10" Foreground="#888"/>
                                            <Grid Margin="0,3,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="HTTP or HTTPS base URL used by the cloud LLM"/>
                                                <Button Grid.Column="1" Margin="6,0,0,0" Width="30"
                                                        Command="{Binding DataContext.RemoveCloudEndpointCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Remove backup endpoint">
                                                    <TextBlock Text="&#x2715;" FontSize="11"/>
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                            <TextBlock Text="{Binding ValidationMessage}"
                                                       Visibility="{Binding ValidationMessage, Converter={StaticResource StringToVisibilityConverter}}"
                                                       FontSize="10" Foreground="#FCA5A5" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="+ Add backup endpoint"
                                    Command="{Binding AddCloudEndpointCommand}"
                                    Style="{StaticResource ModernButton}"
                                    HorizontalAlignment="Left" Padding="10,5" Margin="0,8,0,0"
                                    FontSize="10" Foreground="#CFCFCF"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="WhisperNote server role" FontSize="11" FontWeight="SemiBold"
                               Foreground="#8F8F8F" Margin="2,0,0,7"/>
                    <Border Background="#222" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Accept remote execution" FontSize="13" Foreground="#E0E0E0"/>
                                    <TextBlock Text="Serve requests on a trusted network using the local model."
                                               FontSize="10" Foreground="#777" Margin="0,3,0,0"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SettingsToggleButton}"
                                              IsChecked="{Binding RemoteServerEnabled, Mode=TwoWay}"/>
                            </Grid>
                            <TextBlock Text="Listen endpoint" FontSize="12" Foreground="#CFCFCF"/>
                            <TextBox Text="{Binding RemoteListenEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding RemoteServerEnabled}" Margin="0,6,0,0"
                                     ToolTip="HTTP prefix to listen on; use 0.0.0.0 to bind all interfaces. LAN bindings may require a Windows URL ACL and firewall rule"/>
                            <TextBlock Text="The default binds all interfaces. Keep the server instance in Local LLM mode and use only a trusted network; authentication and TLS are unchanged."
                                       FontSize="10" Foreground="#777" TextWrapping="Wrap" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Behavior" FontSize="11" FontWeight="SemiBold"
                               Foreground="#8F8F8F" Margin="2,0,0,7"/>
                    <Border Background="#222" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Auto-offload VRAM" FontSize="13" Foreground="#E0E0E0"/>
                                    <TextBlock Text="Stop the local server after each transcription."
                                               FontSize="10" Foreground="#777" Margin="0,3,0,0"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SettingsToggleButton}"
                                              IsChecked="{Binding AutoOffloadVram, Mode=TwoWay}"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Thinking mode" FontSize="13" Foreground="#E0E0E0"/>
                                    <TextBlock Text="Use reasoning mode when the local server restarts."
                                               FontSize="10" Foreground="#777" Margin="0,3,0,0"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SettingsToggleButton}"
                                              IsChecked="{Binding ThinkingEnabled, Mode=TwoWay}"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Run on Windows startup" FontSize="13" Foreground="#E0E0E0"/>
                                    <TextBlock Text="Start WhisperNote when you sign in."
                                               FontSize="10" Foreground="#777" Margin="0,3,0,0"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SettingsToggleButton}"
                                              IsChecked="{Binding StartupEnabled, Mode=TwoWay}"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Recording" FontSize="11" FontWeight="SemiBold"
                               Foreground="#8F8F8F" Margin="2,0,0,7"/>
                    <Border Background="#222" CornerRadius="10" Padding="14" Margin="0,0,0,4">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Global hotkey" FontSize="13" Foreground="#E0E0E0"/>
                                    <TextBlock Text="Hold the key to start and stop recording."
                                               FontSize="10" Foreground="#777" Margin="0,3,0,0"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SettingsToggleButton}"
                                              IsChecked="{Binding HotkeyEnabled, Mode=TwoWay}"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Text="Recording key" FontSize="12" Foreground="#CFCFCF"/>
                            <ComboBox ItemsSource="{Binding HotkeyOptions}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="VirtualKeyCode"
                                      SelectedValue="{Binding HotkeyVirtualKeyCode, Mode=TwoWay}"
                                      IsEnabled="{Binding HotkeyEnabled}"
                                      Margin="0,6,0,0"
                                      Height="30"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button Style="{StaticResource SettingsActionButton}"
                        Background="#2A2A2A" BorderBrush="#444" BorderThickness="1"
                        Foreground="#CFCFCF"
                        Click="CancelButton_Click">Cancel</Button>
                <Button Style="{StaticResource SettingsActionButton}"
                        Background="#2D8A4E" BorderBrush="#3FAE65" BorderThickness="1"
                        Foreground="White" Margin="8,0,0,0"
                        IsEnabled="{Binding AreSettingsValid}"
                        Click="SaveButton_Click">Save settings</Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
